{
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "название", "состав", "спрайт", "особые_параметры"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "название": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "состав": {
      "type": "object",
      "additionalProperties": false,
      "required": ["название", "мобы"],
      "properties": {
        "название": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "число": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 6
          }
        },
        "мобы": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "спрайт": {
      "enum": ["orc", "skeleton", "wolf", "spider", "elemental", "abyss"]
    },
    "особые_параметры": {
      "type": "object"
    }
  }
}
