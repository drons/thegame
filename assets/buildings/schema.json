{
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "название", "категория", "функция", "типичный_npc", "допустимые_тайлы", "особые_параметры"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "название": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "категория": {
      "enum": ["магазин", "школа_навыков", "дом_npc", "пещера", "храм", "магический_знак", "прочее"]
    },
    "функция": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "ассортимент": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^\\S(.*\\S)?$"
      }
    },
    "типичный_npc": {
      "anyOf": [
        { "type": "string", "pattern": "^\\S(.*\\S)?$" },
        { "type": "null" }
      ]
    },
    "допустимые_тайлы": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["песок", "трава", "лес", "холмы", "болото"]
      }
    },
    "размер": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ширина", "высота"],
      "properties": {
        "ширина": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "высота": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "вход": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4
      }
    },
    "особые_параметры": {
      "type": "object"
    }
  }
}
