{
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "название", "мобы", "предметы", "размер", "постройка", "объекты_стен"],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "название": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "мобы": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^assets/((items|skills|npc)/\\d{6}|(spells|mobs|mob_groups|buildings|craft|dungeons)/[a-z][a-z0-9_]*)\\.json$"
      }
    },
    "предметы": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^assets/((items|skills|npc)/\\d{6}|(spells|mobs|mob_groups|buildings|craft|dungeons)/[a-z][a-z0-9_]*)\\.json$"
      }
    },
    "размер": {
      "type": "integer",
      "minimum": 5,
      "maximum": 63
    },
    "постройка": {
      "type": "string",
      "pattern": "^assets/((items|skills|npc)/\\d{6}|(spells|mobs|mob_groups|buildings|craft|dungeons)/[a-z][a-z0-9_]*)\\.json$"
    },
    "объекты_стен": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["rock", "column", "stalactite"]
      }
    },
    "руда": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["предмет", "вид"],
        "properties": {
          "предмет": {
            "type": "string",
            "pattern": "^assets/((items|skills|npc)/\\d{6}|(spells|mobs|mob_groups|buildings|craft|dungeons)/[a-z][a-z0-9_]*)\\.json$"
          },
          "вид": {
            "type": "string",
            "enum": ["руда", "минерал", "самоцвет"]
          }
        }
      }
    }
  }
}
