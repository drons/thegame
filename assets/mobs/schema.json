{
  "type": "object",
  "required": ["id", "name", "описание", "role", "aggro", "dmg", "hp", "size", "xp", "skills", "spells", "loot", "art"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string" },
    "описание": { "type": "string", "pattern": "^\\s*\\S[\\s\\S]*$" },
    "role": { "enum": ["melee", "ranged", "support", "leader", "shield", "swarm"] },
    "aggro": { "enum": ["aggressive", "neutral", "territorial", "timid"] },
    "dmg": { "type": "number", "minimum": 0.1, "maximum": 10 },
    "hp": { "type": "number", "minimum": 0.1, "maximum": 10 },
    "size": {
      "type": "object",
      "required": ["w", "h"],
      "properties": {
        "w": { "type": "integer", "minimum": 1, "maximum": 5 },
        "h": { "type": "integer", "minimum": 1, "maximum": 5 }
      },
      "additionalProperties": false
    },
    "armor": { "type": "number", "minimum": 0, "maximum": 10 },
    "fast": { "type": "boolean" },
    "traits": {
      "type": "object",
      "properties": {
        "poison": { "type": "boolean" },
        "lifesteal": { "type": "boolean" },
        "regen": { "type": "boolean" },
        "debuff": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "xp": {
      "type": "object",
      "required": ["base", "perLevel"],
      "properties": {
        "base": { "type": "number", "minimum": 0 },
        "perLevel": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "skills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "spells": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
    },
    "loot": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item"],
        "properties": {
          "item": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "chance": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "art": {
      "type": "object",
      "required": ["move", "attack", "dead"],
      "properties": {
        "move": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string", "pattern": "^assets/sprites/mobs/[a-z][a-z0-9_]*_move_[123]\\.svg$" }
        },
        "attack": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": { "type": "string", "pattern": "^assets/sprites/mobs/[a-z][a-z0-9_]*_attack_[123]\\.svg$" }
        },
        "dead": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "type": "string", "pattern": "^assets/sprites/mobs/[a-z][a-z0-9_]*_dead_1\\.svg$" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
