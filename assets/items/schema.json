{
  "type": "object",
  "required": ["id", "name", "kind", "weight", "value", "desc"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string" },
    "kind": { "enum": ["weapon", "armor", "potion", "food", "skill_book", "reagent", "spell_scroll", "resurrection_scroll"] },
    "subtype": { "type": "string", "enum": ["sword", "bow", "heavy"] },
    "weight": { "type": "number", "minimum": 0.05, "maximum": 200 },
    "value": { "type": "number", "minimum": 1, "maximum": 100000 },
    "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
    "desc": { "type": "string" },
    "stats": {
      "type": "object",
      "properties": {
        "damage": { "type": "number", "minimum": 1, "maximum": 100 },
        "armor": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["heal", "mp", "eat", "skill_xp", "spell", "resurrect"] },
        "amount": { "type": "number", "minimum": 1, "maximum": 500 },
        "skill": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "spell": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      },
      "additionalProperties": false
    },
    "loot": {
      "type": "object",
      "required": ["terrains"],
      "properties": {
        "terrains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["глубокая вода", "вода", "песок", "трава", "лес",
                     "холмы", "горы", "болото"]
          }
        },
        "near_mountains": { "type": "boolean" },
        "frequency": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "icon": { "type": "string", "pattern": "^assets/sprites/loot/[\\w_]+\\.svg$" }
  },
  "additionalProperties": false
}
