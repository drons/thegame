{
  "type": "object",
  "required": ["id", "name", "kind", "weight", "value", "desc"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string" },
    "kind": { "enum": ["weapon", "armor", "potion", "food", "skill_book", "reagent", "spell_scroll", "resurrection_scroll", "shield", "artifact", "tool", "ring", "craft_scroll"] },
    "subtype": { "type": "string", "enum": ["sword", "bow", "heavy", "staff"] },
    "weight": { "type": "number", "minimum": 0.05, "maximum": 200 },
    "value": { "type": "number", "minimum": 1, "maximum": 100000 },
    "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
    "desc": { "type": "string" },
    "stats": {
      "type": "object",
      "properties": {
        "damage": { "type": "number", "minimum": 1, "maximum": 100 },
        "armor": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "effect": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["heal", "mp", "eat", "skill_xp", "spell", "resurrect", "craft_recipe"] },
        "amount": { "type": "number", "minimum": 1, "maximum": 500 },
        "skill": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "spell": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "recipe": { "type": "string", "pattern": "^assets/craft/\\d{6}\\.json$" }
      },
      "additionalProperties": false
    },
    "loot": {
      "type": "object",
      "required": ["terrains"],
      "properties": {
        "terrains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["глубокая вода", "вода", "песок", "трава", "лес",
                     "холмы", "горы", "болото"]
          }
        },
        "near_mountains": { "type": "boolean" },
        "frequency": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "icon": { "type": "string", "pattern": "^assets/sprites/(loot|items)/[\\w_]+\\.svg$" },
    "slot": {
      "type": "string",
      "enum": ["head", "ears", "neck", "torso", "forearms",
               "right_hand", "left_hand", "palms", "ring", "legs", "feet"]
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "rare", "epic", "legendary", "impossible"]
    },
    "set": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "affixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["type", "skill", "amount"],
            "properties": {
              "type": { "const": "skill" },
              "skill": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "amount": { "type": "number" }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["type", "spell"],
            "properties": {
              "type": { "const": "free_cast" },
              "spell": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "set_bonus": {
      "type": "object",
      "anyOf": [
        { "required": ["2"] },
        { "required": ["3"] },
        { "required": ["4"] }
      ],
      "properties": {
        "2": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["type", "skill", "amount"],
                    "properties": {
                      "type": { "const": "skill" },
                      "skill": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                      "amount": { "type": "number" }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["type", "spell"],
                    "properties": {
                      "type": { "const": "free_cast" },
                      "spell": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            {
              "type": "object",
              "anyOf": [
                { "required": ["armor"] },
                { "required": ["damage"] }
              ],
              "properties": {
                "damage": { "type": "number", "minimum": 1, "maximum": 100 },
                "armor": { "type": "number", "minimum": 0, "maximum": 100 }
              },
              "additionalProperties": false
            }
          ]
        },
        "3": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["type", "skill", "amount"],
                    "properties": {
                      "type": { "const": "skill" },
                      "skill": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                      "amount": { "type": "number" }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["type", "spell"],
                    "properties": {
                      "type": { "const": "free_cast" },
                      "spell": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            {
              "type": "object",
              "anyOf": [
                { "required": ["armor"] },
                { "required": ["damage"] }
              ],
              "properties": {
                "damage": { "type": "number", "minimum": 1, "maximum": 100 },
                "armor": { "type": "number", "minimum": 0, "maximum": 100 }
              },
              "additionalProperties": false
            }
          ]
        },
        "4": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["type", "skill", "amount"],
                    "properties": {
                      "type": { "const": "skill" },
                      "skill": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
                      "amount": { "type": "number" }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": ["type", "spell"],
                    "properties": {
                      "type": { "const": "free_cast" },
                      "spell": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            {
              "type": "object",
              "anyOf": [
                { "required": ["armor"] },
                { "required": ["damage"] }
              ],
              "properties": {
                "damage": { "type": "number", "minimum": 1, "maximum": 100 },
                "armor": { "type": "number", "minimum": 0, "maximum": 100 }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
