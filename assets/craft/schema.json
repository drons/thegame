{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "название",
    "тип",
    "результат",
    "исходники",
    "навыки",
    "здания",
    "уровень",
    "описание"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "название": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "тип": {
      "enum": [
        "кузнечное_дело",
        "алхимия",
        "резьба_по_камню",
        "столярное_дело",
        "зачарование",
        "рунопись"
      ]
    },
    "база": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "результат": {
      "type": "object",
      "additionalProperties": false,
      "required": ["предмет", "количество"],
      "properties": {
        "предмет": {
          "type": "string",
          "pattern": "^assets/items/\\d{6}\\.json$"
        },
        "количество": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        }
      }
    },
    "исходники": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["предмет", "количество"],
        "properties": {
          "предмет": {
            "type": "string",
            "pattern": "^assets/items/\\d{6}\\.json$"
          },
          "количество": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      }
    },
    "навыки": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^assets/skills/\\d{6}\\.json$"
      }
    },
    "здания": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^assets/buildings/\\d{6}\\.json$"
      }
    },
    "заклинания": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "уровень": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "описание": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    }
  }
}
