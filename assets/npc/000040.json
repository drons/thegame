{
  "id": "moon_priestess",
  "имя": "Велена",
  "роль": "жрица",
  "описание": "Седая коса, голос тише шага: смотрит на лунные пятна и молчит, пока гость сам не доскажет. Никогда не толкует сны при свидетелях — только наедине и только шёпотом. Читает сны как раскрытую ладонь.",
  "постройки": [
    "assets/buildings/moon_temple.json"
  ],
  "диалог": [
    {
      "id": "prives",
      "текст": "Не в голос: у этой залы слух длинный, а у луны ответ короткий — скажешь громко, и ночь промолчит.",
      "действие": "подсказка"
    },
    {
      "id": "trade",
      "текст": "Свитки тени — в нижней корзине: при луне они стоят своего серебра, при солнце теряют половину.",
      "действие": "торговля"
    },
    {
      "id": "hint_dream",
      "текст": "Сон про спуск — к добыче, сон про воду — к обходу: запомни первое, что встретилось тебе в темноте, — оно и есть ответ.",
      "действие": "подсказка",
      "требования": {
        "харизма": 3
      }
    }
  ],
