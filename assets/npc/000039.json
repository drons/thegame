{
  "id": "sun_priest",
  "имя": "Яровит",
  "роль": "жрец",
  "описание": "Смуглый, с выбеленной солнцем повязкой на лбу: на лицо больного смотрит так, как смотрят на полдень, — прищурившись и не отводя глаз. Свежую рану обкладывает прохладой, а старую расспрашивает, отчего та не закрывается. Лечит светом и знает наизусть всякий свиток исцеления.",
  "постройки": [
    "assets/buildings/temple.json"
  ],
  "диалог": [
    {
      "id": "prives",
      "текст": "Свет прежде всего: войди, путник, пока солнце высокое, — к вечеру целительное сдаёт и требует вдвое.",
      "действие": "подсказка"
    },
    {
      "id": "trade",
      "текст": "Свитки исцеления — с солнечной полки: бери ровно тот, что залечишь сегодня; прочие подождут за тебя.",
      "действие": "торговля"
    },
    {
      "id": "hint_light",
      "текст": "Рана любит ровный свет, а не спешку: закрою повязкой и дождусь зари — к утру жар спадает, и тогда свиток ложится чисто.",
      "действие": "подсказка",
      "требования": {
        "харизма": 3
      }
    }
  ],
