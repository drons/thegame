{
  "id": "mountain_priest",
  "имя": "Утёс",
  "роль": "жрец",
  "описание": "Кряжистый, с мозолистой ладонью: говорит мало и по делу, а слушает долго. Благословляет броню перед выходом и окликает каждого, кто собирается в подземелье налегке. Знает все тропы на две долины вокруг.",
  "постройки": [
    "assets/buildings/mountain_temple.json"
  ],
  "диалог": [
    {
      "id": "prives",
      "текст": "Говори прямо, как тропа: гора лишних слов не держит.",
      "действие": "подсказка"
    },
    {
      "id": "trade",
      "текст": "Природа и защита — два камня моей полки: бери тот, что ближе к поясу; второй дождётся.",
      "действие": "торговля"
    },
    {
      "id": "hint_rock",
      "текст": "Кто идёт в подземелье без свитка защиты, тот возвращается ко мне за бинтами: держу и свитки, и бинты — но за одними и теми же дверями.",
      "действие": "подсказка",
      "требования": {
        "харизма": 3
      }
    }
  ],
