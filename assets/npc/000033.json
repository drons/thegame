{
  "id": "scroll_merchant",
  "имя": "Пергамент",
  "роль": "торговец свитками",
  "описание": "Сухощавый человек с чернильными пятнами до локтя: разворачивает свиток одним движением и, не читая, называет школу и ранг заклинания по краю пергамента. В торге не настырен: за подлинник называет цену без скидок, за подделку не берёт вовсе. Покупает и продаёт свитки; знает, какое заклинание в каком.",
  "постройки": [
    "assets/buildings/magic_shop.json"
  ],
  "диалог": [
    {
      "id": "prives",
      "текст": "Не торопись, путник: свиток не торопится — у него вся жизнь между строк, он уже дожидался и ещё дождётся.",
      "действие": "подсказка"
    },
    {
      "id": "trade",
      "текст": "Свитки заклинаний — из открытого ящика, бери при дневном свете",
      "действие": "торговля"
    },
    {
      "id": "hint_hand",
      "текст": "Заклинание в свитке узнаю по одному почерку: верная рука ведёт буквы ровно, ученическая гонит перо к концу строки — чернила помнят и то и другое.",
      "действие": "подсказка",
      "требования": {
        "харизма": 3
      }
    }
  ],
