{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "название",
    "террейны",
    "спрайт",
    "частота",
    "размер"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
    },
    "название": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "террейны": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "песок",
          "трава",
          "лес",
          "холмы",
          "болото",
          "горы",
          "вода",
          "глубокая вода"
        ]
      }
    },
    "спрайт": {
      "type": "string",
      "pattern": "^assets/sprites/visuals/[A-Za-z0-9_.-]+\\.svg$"
    },
    "частота": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "размер": {
      "type": "number",
      "minimum": 0.05,
      "maximum": 0.5
    }
  }
}
