{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "название",
    "школа",
    "база",
    "степень",
    "атрибут",
    "уровень",
    "мани",
    "действие",
    "здания",
    "описание",
    "icon",
    "icon_prompt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "название": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "школа": {
      "enum": ["огонь", "лёд", "тень", "исцеление", "защита", "природа"]
    },
    "база": {
      "anyOf": [
        { "type": "string", "pattern": "^assets/spells/\\d{6}\\.json$" },
        { "type": "null" }
      ]
    },
    "степень": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "атрибут": {
      "enum": ["intelligence", "wisdom"]
    },
    "уровень": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "мани": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "действие": {
      "enum": ["урон", "лечение", "защита", "ослабление", "контроль", "воскрешение", "баф", "дебаф", "призыв", "создание", "невидимость", "телепорт", "внебой"]
    },
    "параметры": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stat": {
          "enum": ["урон", "броня", "ход", "реген", "вампиризм", "отражение", "попадание", "получаемый_урон", "иммунитет_контроля", "урон_вниз", "броня_вниз", "попадание_вниз", "получаемый_урон_вверх", "dot", "ход_вниз"]
        },
        "value": { "type": "number", "minimum": 0 },
        "turns": { "type": "integer", "minimum": 1 },
        "summon": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "object": { "enum": ["стена", "зона"] },
        "radius": { "type": "integer", "minimum": 1, "maximum": 5 },
        "days": { "type": "integer", "minimum": 1, "maximum": 3 },
        "mode": { "enum": ["метка_установить", "метка_вернуться", "город"] }
      }
    },
    "вне_боя": {
      "type": "boolean"
    },
    "предметы": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^assets/items/\\d{6}\\.json$"
      }
    },
    "здания": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^assets/buildings/\\d{6}\\.json$"
      }
    },
    "описание": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "icon": {
      "type": "string",
      "pattern": "^assets/[a-z0-9_-]+/[a-z][a-z0-9_]*\\.svg$"
    },
    "icon_prompt": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    }
  }
}
