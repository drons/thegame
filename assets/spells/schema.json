{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "название",
    "школа",
    "база",
    "степень",
    "атрибут",
    "уровень",
    "мани",
    "действие",
    "здания",
    "описание"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "название": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    },
    "школа": {
      "enum": ["огонь", "лёд", "тень", "исцеление", "защита", "природа"]
    },
    "база": {
      "anyOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        { "type": "null" }
      ]
    },
    "степень": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "атрибут": {
      "enum": ["intelligence", "wisdom"]
    },
    "уровень": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "мани": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "действие": {
      "enum": ["урон", "лечение", "защита", "ослабление", "контроль"]
    },
    "предметы": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "здания": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 999999
      }
    },
    "описание": {
      "type": "string",
      "pattern": "^\\S(.*\\S)?$"
    }
  }
}
